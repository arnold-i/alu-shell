#!/bin/bash
water="water"
stir="stir."
bestchol="bestchol"

char_index() {
    local ch="$1" alpha="$2"
    for (( i=0; i<${#alpha}; i++ )); do
        [[ "${alpha:$i:1}" == "$ch" ]] && echo $i && return
    done
    echo -1
}

to_decimal() {
    local num="$1" alpha="$2"
    local base=${#alpha} result=0
    for (( i=0; i<${#num}; i++ )); do
        local pos
        pos=$(char_index "${num:$i:1}" "$alpha")
        result=$(( result * base + pos ))
    done
    echo $result
}

from_decimal() {
    local num=$1 alpha="$2"
    local base=${#alpha} result=""
    if [ $num -eq 0 ]; then echo "${alpha:0:1}"; return; fi
    while [ $num -gt 0 ]; do
        result="${alpha:$(( num % base )):1}$result"
        num=$(( num / base ))
    done
    echo "$result"
}

w_dec=$(to_decimal "$WATER" "$water")
s_dec=$(to_decimal "$STIR"  "$stir")
from_decimal $(( w_dec + s_dec )) "$bestchol"
